							"content": [
								{
									"type": "text",
									"text": "The primary difference is that "
								},
								{
									"type": "text",
									"marks": [
										{
											"type": "code"
										}
									],
									"text": "struct sockaddr"
								},
								{
									"type": "text",
									"text": " is "
								},
								{
									"type": "text",
									"marks": [
										{
											"type": "highlight"
										},
										{
											"type": "bold"
										}
									],
									"text": "a generic, fixed-size structure used for casting pointers in system calls, while "
								},
								{
									"type": "text",
									"marks": [
										{
											"type": "highlight"
										},
										{
											"type": "bold"
										},
										{
											"type": "code"
										}
									],
									"text": "struct sockaddr_storage"
								},
								{
									"type": "text",
									"marks": [
										{
											"type": "highlight"
										},
										{
											"type": "bold"
										}
									],
									"text": " is a guaranteed-large-enough and properly aligned structure to hold any type of socket address"
								},
								{
									"type": "text",
									"text": " (IPv4, IPv6, etc.)."
								}
							]
						}
					]
