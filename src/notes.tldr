								{
									"type": "text",
									"marks": [
										{
											"type": "code"
										}
									],
									"text": "❌ Hard ceiling (often 1024) — fails if you try fd = 1025✅ No arbitrary limit — works with fd = 1000000 (if the kernel allows it)"
								},
								{
									"type": "text",
									"marks": [
										{
											"type": "bold"
										},
										{
											"type": "code"
