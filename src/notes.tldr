										{
											"type": "bold"
										},
										{
											"type": "code"
										}
									],
									"text": "Featureselect()poll()How it tracks fds"
								},
								{
									"type": "text",
									"marks": [
										{
											"type": "code"
										}
									],
									"text": "Uses a "
