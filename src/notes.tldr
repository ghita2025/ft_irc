											"content": [
												{
													"type": "text",
													"marks": [
														{
															"type": "code"
														}
													],
													"text": "Or a "
												},
												{
													"type": "text",
													"marks": [
														{
															"type": "bold"
														},
														{
															"type": "code"
														}
													],
													"text": "minimal runnable C snippet"
												},
												{
													"type": "text",
													"marks": [
														{
															"type": "code"
														}
													],
													"text": " comparing both? "
												},
												{
													"type": "text",
													"text": "Feature "
												},
												{
													"type": "text",
													"marks": [
														{
															"type": "code"
														}
													],
													"text": "select()"
												},
												{
													"type": "text",
													"text": " "
												},
												{
													"type": "text",
													"marks": [
														{
															"type": "code"
														}
													],
													"text": "poll()"
												},
												{
													"type": "text",
													"text": " "
												},
												{
													"type": "text",
													"marks": [
														{
															"type": "bold"
														}
													],
													"text": "How it tracks fds"
												},
												{
													"type": "text",
													"text": " Uses a "
												},
												{
													"type": "text",
													"marks": [
														{
															"type": "italic"
														}
													],
													"text": "bitmask"
												},
												{
													"type": "text",
													"text": " (like a giant checkbox list from fd "
												},
												{
													"type": "text",
													"marks": [
														{
															"type": "code"
														}
													],
													"text": "0"
												},
												{
													"type": "text",
													"text": " to "
												},
												{
													"type": "text",
													"marks": [
														{
															"type": "code"
														}
													],
													"text": "FD_SETSIZE−1"
												},
												{
													"type": "text",
													"text": ") Uses an "
												},
												{
													"type": "text",
													"marks": [
														{
															"type": "italic"
														}
													],
													"text": "array of structs"
												},
												{
													"type": "text",
													"text": ": one entry per fd you actually care about "
												},
												{
													"type": "text",
													"marks": [
														{
															"type": "bold"
														}
													],
													"text": "Memory use"
												},
												{
													"type": "text",
													"text": " ❌ Wastes space: allocates for "
												},
												{
													"type": "text",
													"marks": [
														{
															"type": "italic"
														}
													],
													"text": "all possible fds up to 1024 (or 65536)"
												},
												{
													"type": "text",
													"text": " — even if you only monitor fd "
												},
												{
													"type": "text",
													"marks": [
														{
															"type": "code"
														}
													],
													"text": "999"
												},
												{
													"type": "text",
													"text": " and "
												},
												{
													"type": "text",
													"marks": [
														{
															"type": "code"
														}
													],
													"text": "1000"
												},
												{
													"type": "text",
													"text": " ✅ Efficient: only stores what you need — e.g., 2 structs for 2 fds "
												},
												{
													"type": "text",
													"marks": [
														{
															"type": "bold"
														}
													],
													"text": "Scalability limit"
												},
												{
													"type": "text",
													"text": " ❌ Hard ceiling (often "
												},
												{
													"type": "text",
													"marks": [
														{
															"type": "code"
														}
													],
													"text": "1024"
												},
												{
													"type": "text",
													"text": ") — fails if you try "
												},
												{
													"type": "text",
													"marks": [
														{
															"type": "code"
														}
													],
													"text": "fd = 1025"
												},
												{
													"type": "text",
													"text": " ✅ No arbitrary limit — works with "
												},
												{
													"type": "text",
													"marks": [
														{
															"type": "code"
														}
													],
													"text": "fd = 1000000"
												},
												{
													"type": "text",
													"text": " (if the kernel allows it) "
												},
												{
													"type": "text",
													"marks": [
														{
															"type": "bold"
														}
													],
													"text": "Time cost"
												},
												{
													"type": "text",
													"text": " ❌ Must scan "
												},
												{
													"type": "text",
													"marks": [
														{
															"type": "italic"
														}
													],
													"text": "every bit"
												},
												{
													"type": "text",
													"text": " from "
												},
												{
													"type": "text",
													"marks": [
														{
															"type": "code"
														}
													],
													"text": "0"
												},
												{
													"type": "text",
													"text": " to "
												},
												{
													"type": "text",
													"marks": [
														{
															"type": "code"
														}
													],
													"text": "maxfd"
												},
												{
													"type": "text",
													"text": " — slow when "
												},
												{
													"type": "text",
													"marks": [
														{
															"type": "code"
														}
													],
													"text": "maxfd"
												},
												{
													"type": "text",
													"text": " is huge but sparse ✅ Only loops over your "
												},
												{
													"type": "text",
													"marks": [
														{
															"type": "italic"
														}
													],
													"text": "actual array length"
												},
												{
													"type": "text",
													"text": " — fast & predictable "
												},
												{
													"type": "text",
													"marks": [
														{
															"type": "bold"
														}
													],
													"text": "Simple mental model"
												},
												{
													"type": "text",
													"text": " 🚪 "
												},
												{
													"type": "text",
													"marks": [
														{
															"type": "italic"
														}
													],
													"text": "\"You walk down every door in a 1024-room hallway — even if only doors #999 and #1000 have people behind them.\""
												},
												{
													"type": "text",
													"text": " 🚪 "
												},
												{
													"type": "text",
													"marks": [
														{
															"type": "italic"
														}
													],
													"text": "\"You knock only on the 2 doors you care about — no hallway walking required.\""
												}
											]
										}
									]
								}
							]
						}
					]
				}
